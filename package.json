{
  "name": "tomas-travel-journal-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate.mjs && node scripts/clean-build.mjs && astro build && node scripts/verify-build.mjs",
    "build:preview": "TTJ_PREVIEW=1 npm run build",
    "preview": "astro preview --host 0.0.0.0",
    "import:demo": "node scripts/prepare-demo.mjs && node scripts/import.mjs .work/demo-package.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.5",
    "d3-geo": "3.1.1",
    "sharp": "0.35.5",
    "suncalc": "2.0.2",
    "three": "0.186.1",
    "three-conic-polygon-geometry": "2.1.3"
  }
}
