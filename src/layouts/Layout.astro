---
import '../styles/global.css';
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/manrope';
import Brand from '../components/Brand.astro';
import Compass from '../components/Compass.astro';
import {preview} from '../lib/content';
const {title='Tomas Travel Journal',description='Tomo Gaižausko kelionių užrašai. Šalys, istorijos ir maršrutai.'}=Astro.props;
const path=Astro.url.pathname;
const nav=[{href:'/#gaublys',label:'Gaublys',active:path==='/'},{href:'/salys/',label:'Šalių atlasas',active:path.startsWith('/salys/')},{href:'/istorijos/',label:'Istorijos',active:path.startsWith('/istorijos/')}];
---
<!doctype html>
<html lang="lt">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={description}/><meta name="theme-color" content="#f5efdf"/>
  <meta name="robots" content="noindex,nofollow"/><title>{title}</title>
  <link rel="icon" href="/brand/favicon.png" type="image/png"/>
</head>
<body>
<a class="skip" href="#main">Pereiti prie turinio</a>
{preview&&<div class="preview-note"><span>BANDOMOJI SVETAINĖ</span><span>Pavyzdinės istorijos · ne Tomo kelionių faktai</span></div>}
<header class="header wrap">
  <Brand/>
  <nav aria-label="Pagrindinė navigacija">{nav.map(item=><a href={item.href} aria-current={item.active?'page':undefined}>{item.label}</a>)}</nav>
  <span class="header-byline">KELIONĖS. NUOTRAUKOS.<br/>ISTORIJOS.</span>
</header>
<main id="main"><slot/></main>
<footer class="footer">
  <div class="footer-ornament wrap"><span></span><Compass/><span></span></div>
  <div class="footer-inner wrap"><Brand footer/><p>Tomo Gaižausko<br/><span>kelionių užrašai</span></p><div class="footer-links"><a href="/salys/">Šalių atlasas ↗</a><a href="/saltiniai/">Žemėlapio ir vaizdų šaltiniai ↗</a></div></div>
  <div class="footer-bottom wrap"><span>TRAVEL PHOTOS AND STORIES</span><span>TOMAS TRAVEL JOURNAL</span></div>
</footer>
</body>
</html>
