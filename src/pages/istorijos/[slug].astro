---
import Layout from '../../layouts/Layout.astro';import Gallery from '../../components/Gallery.astro';import Route from '../../components/Route.astro';import {stories,countries,countryUrl} from '../../lib/content';
export function getStaticPaths(){return stories.map(story=>({params:{slug:story.slug},props:{story}}));}const {story}=Astro.props;
---
<Layout title={story.title+' · Tomas Travel Journal'} description={story.excerpt}><article><header class="article-head wrap"><a class="back-link" href="/istorijos/">← Visos istorijos</a><p class="eyebrow">{story.countryIds.map(id=><a href={countryUrl(id)}>{countries.find(c=>c.country_id===id)?.name_lt}</a>)} · {story.synthetic?'TESTINĖ ISTORIJA':'KELIONĖS UŽRAŠAI'}</p><h1>{story.title}<span class="title-dot">.</span></h1><p class="article-deck">{story.slug==='miestai-ir-ezerai'?'Nuo miesto gatvių iki pajūrio. Penkios stotelės viename bandomajame maršrute.':story.slug==='pajurio-dienorastis'?'Antras pasakojimas apie tą pačią šalį. Galerijos ir ramaus skaitymo bandymas.':story.excerpt}</p>{story.synthetic&&<p class="test-note">Sintetinis pavyzdys · nėra tikrų kelionės datų ar Tomo patirčių.</p>}</header><div class="article-body">{story.paragraphs.map((p,i)=><p class:list={[{dropcap:i===1}]}>{p}</p>)}</div>{story.routes.map(route=><Route route={route}/>)}<Gallery items={story.gallery}/><div class="article-end"><span>↟</span><p>Viena istorija. Dar vienas žvilgsnis į pasaulį.</p><a href={countryUrl(story.countryIds[0])} class="text-link">Daugiau apie šią šalį →</a></div></article></Layout>
