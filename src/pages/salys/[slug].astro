---
import Layout from '../../layouts/Layout.astro';import StoryRow from '../../components/StoryRow.astro';import {countries,countryStories,continents,preview} from '../../lib/content';
export function getStaticPaths(){return countries.map(country=>({params:{slug:country.iso_alpha2.toLowerCase()},props:{country}}));}
const {country}=Astro.props;const related=countryStories(country.country_id);
---
<Layout title={country.name_lt+' · Tomas Travel Journal'}><section class="wrap country-head"><a href="/salys/" class="back-link">← Šalių atlasas</a><div class="country-heading"><div><p class="eyebrow">{continents[country.continent_id]||''} · {country.iso_alpha2}</p><h1>{country.name_lt}<span class="title-dot">.</span></h1><p>{related.length?`${related.length} istorijos viename šalies puslapyje.`:'Šios šalies istorijų dar nėra.'}</p>{preview&&related.length>0&&<p class="test-note">Testinis Lietuvos rinkinys. Ne Tomo kelionių faktai.</p>}</div><div class="country-stamp" aria-hidden="true"><span>{country.iso_alpha3}</span><small>TOMAS TRAVEL JOURNAL</small></div></div></section><section class="wrap country-stories"><div class="section-heading"><h2>{related.length?'Šalies užrašai':'Dar neužrašyta'}</h2><a href="/#gaublys" class="text-link">Grįžti prie gaublio ↗</a></div>{related.length?related.map(story=><StoryRow story={story}/>):<div class="empty-story"><p>Turinys čia atsiras, kai bus paruošta ir patvirtinta istorija.</p><p>Tuščias puslapis nepasako, ar Tomas lankėsi šioje šalyje.</p><a href="/istorijos/" class="text-link">Skaityti esamas istorijas →</a></div>}</section></Layout>
