---
import Layout from '../../layouts/Layout.astro';import Search from '../../components/Search.astro';import {countries,countryStories,continents,visits,preview} from '../../lib/content';
---
<Layout title="Šalių atlasas · Tomas Travel Journal"><section class="wrap page-head"><p class="eyebrow">ŠALIŲ ATLASAS</p><h1>Kiekviena šalis.<br/><em>Sava istorija.</em></h1><p>{preview?'Šiame bandomajame atlase turinį turi Lietuva. Kitų šalių puslapiai dar laukia istorijų.':'Kelionių archyvas pildomas.'}</p><Search compact id="atlas-search"/></section><section class="wrap atlas"><div class="atlas-summary"><strong>{visits.filter(v=>v.status==='visited').length}<small> / 195</small></strong><p>{preview?'Testiniame rinkinyje pažymėta šalis':'Patvirtintos aplankytos šalys'}<br/><span>{preview?'Tai nėra tikroji Tomo kelionių statistika.':''}</span></p></div>{Object.entries(continents).map(([key,name])=><section class="continent"><div><h2>{name}</h2><p>{countries.filter(c=>c.continent_id===key&&visits.some(v=>v.countryId===c.country_id&&v.status==='visited')).length} / {countries.filter(c=>c.continent_id===key).length}{preview?' · testas':''}</p></div><ul>{countries.filter(c=>c.continent_id===key).sort((a,b)=>a.name_lt.localeCompare(b.name_lt,'lt')).map(c=><li><a href={'/salys/'+c.iso_alpha2.toLowerCase()+'/'} class:list={[{'has-stories':countryStories(c.country_id).length>0}]}>{c.name_lt}{countryStories(c.country_id).length>0&&<small>{countryStories(c.country_id).length} istorijos ↗</small>}</a></li>)}</ul></section>)}</section></Layout>
